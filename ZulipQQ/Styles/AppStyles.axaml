<!-- 全局通用样式；页面专用样式写在各自的 View 中 -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ZulipQQ.Controls">

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 文字层级 -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.sub">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSub}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>

    <!-- 在线状态小圆点，叠放在头像右下角 -->
    <Style Selector="Ellipse.online">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="{DynamicResource OnlineBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- 搜索框：灰底圆角，去掉 Fluent 的边框与焦点下划线 -->
    <Style Selector="TextBox.search">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource FillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.search /template/ Border#PART_BorderElement,
                     TextBox.search:pointerover /template/ Border#PART_BorderElement,
                     TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 带焦点边框的搜索框（群成员搜索）：未选中时同上，选中时品牌色边框；边框一直占 1px，选中时文字不跳动 -->
    <Style Selector="TextBox.search.ring /template/ Border#PART_BorderElement,
                     TextBox.search.ring:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.search.ring:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 普通输入框：白底灰边框，聚焦时品牌色边框 -->
    <Style Selector="TextBox.input">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.input /template/ Border#PART_BorderElement,
                     TextBox.input:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.input:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 对话框按钮（需配合 Theme="{StaticResource FlatButton}"） -->
    <Style Selector="Button.primary, Button.secondary">
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource BrandDisabledBrush}" />
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    </Style>

    <!-- 对话框外框 -->
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #33000000" />
    </Style>

    <!-- 名片弹出层：名片自带背景和圆角 -->
    <Style Selector="FlyoutPresenter.card">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxWidth" Value="400" />
        <Setter Property="CornerRadius" Value="8" />
        <!-- 弹出层窗口不显示超出自身的阴影，用细边框与背景区分 -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>

    <!-- 群成员列表：紧凑行高，悬停、选中都只变灰 -->
    <Style Selector="ListBox.members ListBoxItem">
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.members ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBox.members ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>

    <!-- 群成员徽标：默认为“管理员”的蓝色，.owner 为“群主”的橙色 -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AdminBadgeFillBrush}" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
    </Style>
    <Style Selector="Border.badge.owner">
        <Setter Property="Background" Value="{DynamicResource OwnerBadgeFillBrush}" />
    </Style>
    <Style Selector="Border.badge.owner > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OwnerBadgeBrush}" />
    </Style>

    <!-- 菜单（右键菜单、下拉菜单、子菜单）：颜色和尺寸见 Theme.axaml 的 MenuFlyout* 资源；一级菜单的图标见 MenuIcons -->
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <!-- 鼠标移入菜单项时，图标弹跳两下（第二下的幅度和时长都是第一下的一半：0.25 秒 + 0.125 秒，只播放一次）。
         用 TdIcon.Zoom 放大，线宽只变粗一半（RenderTransform 缩放会让线条同比变粗、看起来变黑） -->
    <!-- 主菜单（Button.menuRow，见 MainWindow）的菜单项同样处理；顶部收藏、文件、调色盘不加 -->
    <!-- 图标放大时会画出 16x16 的范围：图标容器（ContentControl）和它模板中的 Viewbox 默认都裁剪超出部分（铃铛等顶到边缘的图标会被切掉） -->
    <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter, MenuItem /template/ ContentControl#PART_IconPresenter /template/ Viewbox">
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="MenuItem:pointerover c|TdIcon, Button.menuRow:pointerover c|TdIcon">
        <Style.Animations>
            <Animation Duration="0:0:0.375">
                <KeyFrame Cue="0%">
                    <Setter Property="Zoom" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="27%">
                    <Setter Property="Zoom" Value="1.2" />
                </KeyFrame>
                <KeyFrame Cue="67%">
                    <Setter Property="Zoom" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="80%">
                    <Setter Property="Zoom" Value="1.1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Zoom" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- 子菜单箭头与勾选标记（仿 QQ）：1px 细线的小箭头和对勾，代替 Fluent 的实心大箭头、实心对勾和单选圆点。
         箭头的尺寸和形状写在 Fluent 模板中，普通样式的优先级比模板低，所以选择器带上伪类（:not(:separator)）提高优先级 -->
    <Style Selector="MenuItem:not(:separator) /template/ Path#PART_ChevronPath">
        <Setter Property="Data" Value="M0.5,0.5 L5,5 L0.5,9.5" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding $parent[MenuItem].Foreground}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <!-- 勾选 / 单选项的对勾与图标放在同一位置（图标列），未选中时也占位：选中与否文字位置不变，与带图标的项对齐。
         图标列在同一个菜单中共享宽度（Fluent 的 SharedSizeGroup），只要有一项有图标或勾选位，所有项都留出这一列。
         模板中写死了 Grid.Column 和 IsVisible，选择器带伪类才能覆盖 -->
    <Style Selector="MenuItem:toggle /template/ ContentControl#PART_ToggleIconPresenter, MenuItem:radio /template/ ContentControl#PART_ToggleIconPresenter">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="MenuItem:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter, MenuItem:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
        <Setter Property="Content">
            <Template>
                <Path Data="M0.5,4 L4,7.5 L11.5,0.5" Stretch="None" Width="12" Height="8"
                      Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="1.2" />
            </Template>
        </Setter>
    </Style>
    <!-- 子菜单上移外框到第一项的距离（边框 1 + 内边距 4 + 列表上边距 4），第一项与父菜单项在同一行 -->
    <Style Selector="MenuItem /template/ Popup#PART_Popup">
        <Setter Property="VerticalOffset" Value="-9" />
    </Style>
    <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator, MenuItem Separator">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutSeparatorBackground}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSub}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- 滚动条不再展开（见 Theme.axaml 的 ScrollBar）：两条滚动条交汇处的角块也不显示 -->
    <Style Selector="ScrollViewer /template/ Panel#PART_ScrollBarsSeparator">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- 滚动条平时隐藏：鼠标在可滚动区域内时显示（直接属于该区域的滚动条） -->
    <Style Selector="ScrollViewer:pointerover /template/ ScrollBar /template/ Thumb">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 带 fadeScrollBar 类的区域（聊天消息区）：鼠标离开后滚动条 0.3 秒渐隐；进入时立即显示（过渡只在离开状态下设置）。
         其它区域离开后立即消失 -->
    <Style Selector="ScrollViewer.fadeScrollBar:not(:pointerover) /template/ ScrollBar:not(:pointerover) /template/ Thumb:not(:pressed)">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
