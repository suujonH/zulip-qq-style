<!-- 颜色取自 QQ 截图；无样式的扁平控件主题 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 字号：以正文字号 n（设置 > 通用 > 字体大小，默认 14）为基准，由 ThemeService 统一调整 -->
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <x:Double x:Key="FontSizeH2">16</x:Double>
    <x:Double x:Key="FontSizeH3">15</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSmall">13</x:Double>
    <x:Double x:Key="FontSizeSub">12</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>

    <!-- 颜色按主题变体分两组；超级调色盘的强调色、背景图透明度由 ThemeService 在顶层覆盖 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCDCDC" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="FillBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="HoverBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="PressedBrush" Color="#D9D9D9" />
            <!-- 表格线：半透明，在蓝色、灰色气泡和输入框上都看得清 -->
            <SolidColorBrush x:Key="TableBorderBrush" Color="#4D000000" />
            <!-- 消息列表的会话背景（仿 QQ）：置顶或悬停 / 悬停的置顶或选中 / 选中的置顶 -->
            <SolidColorBrush x:Key="ConversationShade1Brush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="ConversationShade2Brush" Color="#E2E2E2" />
            <SolidColorBrush x:Key="ConversationShade3Brush" Color="#D9D9D9" />

            <SolidColorBrush x:Key="BrandBrush" Color="#0099FF" />
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#1AA3FF" />
            <SolidColorBrush x:Key="BrandDisabledBrush" Color="#A3D7FF" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#DCDCDC" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="RowDividerBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="FilterActiveBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="CheckBorderBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="DialogMaskBrush" Color="#66000000" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F74C30" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#2BD158" />
            <SolidColorBrush x:Key="MutedBadgeBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="PlaceholderLogoBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="HelperAvatarBrush" Color="#FA9D3B" />
            <SolidColorBrush x:Key="ResolvedAvatarBrush" Color="#2BA471" />
            <SolidColorBrush x:Key="CardBrush" Color="White" />
            <!-- 菜单（Fluent 主题的资源）：白色卡片、细边框，悬停浅灰 -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="White" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#F0F0F0" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#E6E6E6" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#EBEBEB" />
            <!-- 聊天气泡：自己浅蓝、别人白色；点击后的选中色；跳转高亮 -->
            <SolidColorBrush x:Key="OwnBubbleBrush" Color="#CCE4FF" />
            <SolidColorBrush x:Key="OwnBubbleSelectedBrush" Color="#B3D7FF" />
            <!-- 自己气泡中的链接、提及：BrandBrush 在浅蓝色气泡上对比度不足 -->
            <SolidColorBrush x:Key="OwnLinkBrush" Color="#0058B8" />
            <!-- 行内代码背景：半透明，白色和蓝色气泡上都适用 -->
            <SolidColorBrush x:Key="CodeChipBrush" Color="#14000000" />
            <SolidColorBrush x:Key="OtherBubbleBrush" Color="White" />
            <SolidColorBrush x:Key="OtherBubbleSelectedBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="FlashBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="CheckedRowBrush" Color="#E0E0E0" />
            <!-- 消息中的引用卡片（半透明，叠在白色和蓝色气泡上都适用）；悬停；左侧竖线 -->
            <SolidColorBrush x:Key="QuoteCardBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="QuoteCardHoverBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="QuoteBarBrush" Color="#D0D0D0" />
            <!-- 群成员徽标：群主橙色、管理员蓝色（浅底深字）；名片中的角色徽标 -->
            <SolidColorBrush x:Key="OwnerBadgeBrush" Color="#F5A623" />
            <SolidColorBrush x:Key="OwnerBadgeFillBrush" Color="#FFF4E0" />
            <SolidColorBrush x:Key="AdminBadgeFillBrush" Color="#E0F2FF" />
            <SolidColorBrush x:Key="RoleBadgeFillBrush" Color="#E6F4FF" />
            <!-- 连接状态提示条；搜索命中高亮 -->
            <SolidColorBrush x:Key="WarningFillBrush" Color="#FFF4DB" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#B26B00" />
            <SolidColorBrush x:Key="SearchHighlightBrush" Color="#FFE58F" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#999999" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#B3B3B3" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#262626" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="DividerBrush" Color="#333333" />
            <SolidColorBrush x:Key="FillBrush" Color="#333333" />
            <SolidColorBrush x:Key="HoverBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="PressedBrush" Color="#454545" />
            <SolidColorBrush x:Key="TableBorderBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="ConversationShade1Brush" Color="#333333" />
            <SolidColorBrush x:Key="ConversationShade2Brush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ConversationShade3Brush" Color="#454545" />

            <SolidColorBrush x:Key="BrandBrush" Color="#0099FF" />
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#33ADFF" />
            <SolidColorBrush x:Key="BrandDisabledBrush" Color="#1F4F73" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#454545" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#232323" />
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="RowDividerBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="FilterActiveBrush" Color="#404040" />
            <SolidColorBrush x:Key="CheckBorderBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="DialogMaskBrush" Color="#99000000" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F25C45" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#2BD158" />
            <SolidColorBrush x:Key="MutedBadgeBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="PlaceholderLogoBrush" Color="#333333" />
            <SolidColorBrush x:Key="HelperAvatarBrush" Color="#FA9D3B" />
            <SolidColorBrush x:Key="ResolvedAvatarBrush" Color="#2BA471" />
            <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2B2B2B" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#3A3A3A" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#454545" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#3A3A3A" />
            <SolidColorBrush x:Key="OwnBubbleBrush" Color="#1D4E7A" />
            <SolidColorBrush x:Key="OwnBubbleSelectedBrush" Color="#24609A" />
            <SolidColorBrush x:Key="OwnLinkBrush" Color="#A8D4FF" />
            <SolidColorBrush x:Key="CodeChipBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="OtherBubbleBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="OtherBubbleSelectedBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="FlashBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="CheckedRowBrush" Color="#333333" />
            <SolidColorBrush x:Key="QuoteCardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="QuoteCardHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="QuoteBarBrush" Color="#555555" />
            <SolidColorBrush x:Key="OwnerBadgeBrush" Color="#F5A623" />
            <SolidColorBrush x:Key="OwnerBadgeFillBrush" Color="#4A3A1A" />
            <SolidColorBrush x:Key="AdminBadgeFillBrush" Color="#1A3A55" />
            <SolidColorBrush x:Key="RoleBadgeFillBrush" Color="#1A3A55" />
            <SolidColorBrush x:Key="WarningFillBrush" Color="#3D3218" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#E0A040" />
            <SolidColorBrush x:Key="SearchHighlightBrush" Color="#6B5A1E" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8C8C8C" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#666666" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 菜单的尺寸（Fluent 主题的资源，包括子菜单的弹出层）：圆角卡片、四周留白，菜单项为圆角块 -->
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePadding">10,7,16,7</Thickness>
    <Thickness x:Key="MenuIconPresenterMargin">0,0,10,0</Thickness>
    <!-- 子菜单与父菜单之间留出约 5px 间隙（Fluent 默认 -4，两层菜单重叠；实测 4 时间隙为 0）；上下对齐见 AppStyles 的 PART_Popup -->
    <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">9</x:Double>

    <!-- 只有内容和背景的按钮，悬停/按下变灰 -->
    <ControlTheme x:Key="FlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
        </Style>
    </ControlTheme>

    <!-- 不带任何选中/悬停视觉的列表项，视觉由各自的数据模板通过样式处理 -->
    <ControlTheme x:Key="PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        滚动条（替换 Fluent 默认的样式：悬停一段时间后展开成带箭头和轨道的宽滚动条）：平时隐藏，
        鼠标在可滚动区域内时显示紧贴边缘的 6px 浅灰色滑块（仿 QQ，见 AppStyles.axaml）；悬停、按下时粗细不变。
    -->
    <ControlTheme x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="{DynamicResource ScrollBarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource ScrollBarSize}" />
        <!-- 透明背景：整条区域都能命中悬停 -->
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource ScrollBarThumb}" Width="6" CornerRadius="3" Opacity="0"
                                   HorizontalAlignment="Right" MinHeight="{DynamicResource ScrollBarSize}" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource ScrollBarThumb}" Height="6" CornerRadius="3" Opacity="0"
                                   VerticalAlignment="Bottom" MinWidth="{DynamicResource ScrollBarSize}" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 平时隐藏；鼠标在滚动条上、拖动滑块时（拖出滚动条区域也）显示，粗细不变 -->
        <Style Selector="^:pointerover /template/ Thumb, ^ /template/ Thumb:pressed">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
