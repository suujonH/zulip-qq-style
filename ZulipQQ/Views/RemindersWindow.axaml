<!-- 消息提醒窗口：左侧“待提醒 / 已提醒”，右侧卡片列表；布局与设置窗口相同 -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels"
        xmlns:c="using:ZulipQQ.Controls"
        x:Class="ZulipQQ.Views.RemindersWindow"
        x:DataType="vm:RemindersViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="消息提醒"
        Width="760" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
        </Style>
        <Style Selector="Button.nav TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">
        <c:CaptionBar Grid.Row="0" Height="30" VerticalAlignment="Top" ShowMaximize="False" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <c:TdIcon Icon="{StaticResource Icon.Time}" Width="16" Height="16" />
            <TextBlock Text="消息提醒" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="8,8,0,0" ClipToBounds="True"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,1,0">
            <Grid ColumnDefinitions="160,*">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="8">
                        <Button Classes="nav" Classes.active="{Binding IsPending}" Command="{Binding SelectTabCommand}"
                                CommandParameter="{x:Static vm:ReminderTab.Pending}">
                            <TextBlock Text="待提醒" />
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsDelivered}" Command="{Binding SelectTabCommand}"
                                CommandParameter="{x:Static vm:ReminderTab.Delivered}">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{DynamicResource DangerBrush}" IsVisible="{Binding HasUnreadDelivered}" />
                                <TextBlock Text="已提醒" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Panel Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,20" Spacing="8">
                            <DockPanel Margin="2,0,0,4">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource FlatButton}" Padding="8,4" Content="清除全部"
                                        VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                                        IsVisible="{Binding CanClearAll}" Command="{Binding ClearAllCommand}" />
                                <TextBlock Text="{Binding TabTitle}" FontSize="{DynamicResource FontSizeH2}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReminderItemViewModel">
                                        <Border Classes="card">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <c:TdIcon Icon="{StaticResource Icon.Time}" Width="14" Height="14"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="hint" Text="{Binding TimeText}" />
                                                    <TextBlock Classes="hint" Text="提醒失败" Foreground="{DynamicResource DangerBrush}"
                                                               IsVisible="{Binding IsFailed}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Spacing="2">
                                                    <Button Theme="{StaticResource FlatButton}" Padding="8,4" Content="查看消息"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Foreground="{DynamicResource BrandBrush}"
                                                            IsVisible="{Binding CanView}" Command="{Binding ViewCommand}" />
                                                    <Button Theme="{StaticResource FlatButton}" Padding="8,4" Content="删除"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" />
                                                    <Button Theme="{StaticResource FlatButton}" Padding="8,4" Content="清除"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            IsVisible="{Binding CanClear}" Command="{Binding ClearCommand}" />
                                                </StackPanel>
                                                <c:MessageContent Grid.Row="1" Html="{Binding Html}" Margin="0,6,12,0"
                                                                  TextElement.FontSize="{DynamicResource FontSizeSmall}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeSmall}"
                               IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Border Background="#CC000000" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,16,0,0"
                            IsVisible="{Binding ToastText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" />
                    </Border>
                </Panel>
            </Grid>
        </Border>

        <c:DialogLayer Grid.Row="0" Grid.RowSpan="2" Dialogs="{Binding Dialogs}" />
    </Grid>
</Window>
