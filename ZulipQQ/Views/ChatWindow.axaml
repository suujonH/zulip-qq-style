<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels"
        xmlns:c="using:ZulipQQ.Controls"
        x:Class="ZulipQQ.Views.ChatWindow"
        x:DataType="vm:ChatWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Chat.Title}"
        Width="760" Height="640" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid RowDefinitions="30,*">
        <c:CaptionBar Grid.Row="0" />

        <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="8,8,0,0" ClipToBounds="True"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,1,0">
            <Panel>
                <ContentControl Content="{Binding Chat}" />
                <Border Background="#CC000000" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,64,0,0"
                        IsVisible="{Binding ToastText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" />
                </Border>
            </Panel>
        </Border>

        <c:DialogLayer Grid.Row="0" Grid.RowSpan="2" Dialogs="{Binding Dialogs}" />
    </Grid>
</Window>
