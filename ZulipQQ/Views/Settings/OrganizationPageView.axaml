<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels.Settings"
             xmlns:pvm="using:ZulipQQ.ViewModels"
             x:Class="ZulipQQ.Views.Settings.OrganizationPageView"
             x:DataType="vm:OrganizationPageViewModel">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="pageTitle" Text="组织管理" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary" Theme="{StaticResource FlatButton}" Content="还原"
                    Command="{Binding RevertCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="primary" Theme="{StaticResource FlatButton}" Content="保存"
                    Command="{Binding SaveCommand}" />
        </Grid>

        <TextBlock Classes="section" Text="基本信息" />
        <Border Classes="card">
            <Grid Classes="item" ColumnDefinitions="Auto,*">
                <TextBlock Text="组织名称" />
                <TextBox Grid.Column="1" Classes="input" Width="260" HorizontalAlignment="Right" MaxLength="40"
                         Text="{Binding Name}" />
            </Grid>
        </Border>

        <TextBlock Classes="section" Text="消息" />
        <Border Classes="card">
            <StackPanel>
                <Grid Classes="item" ColumnDefinitions="*,Auto">
                    <TextBlock Text="允许编辑消息" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowEditing}" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="item" ColumnDefinitions="*,Auto">
                    <TextBlock Text="编辑时限" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding Limit}"
                              IsEnabled="{Binding AllowEditing}" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="item" ColumnDefinitions="*,Auto">
                    <TextBlock Text="已读回执" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReadReceipts}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="权限" />
        <Border Classes="card">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:PermissionRowViewModel">
                        <Grid Classes="item" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Label}" />
                            <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Choices}"
                                      SelectedItem="{Binding Selected}" IsEnabled="{Binding IsEditable}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
