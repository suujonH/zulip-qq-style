<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ZulipQQ.Controls"
             xmlns:vm="using:ZulipQQ.ViewModels.Settings"
             xmlns:pvm="using:ZulipQQ.ViewModels"
             x:Class="ZulipQQ.Views.Settings.OrganizationPageView"
             x:DataType="vm:OrganizationPageViewModel">
    <StackPanel Spacing="8">
        <!-- 修改后点击右侧下方提示中的“保存”提交 -->
        <TextBlock Classes="pageTitle" Text="组织管理" />
        <TextBlock Classes="hint" Text="只有组织管理员可以修改，你可以查看当前的设置。" IsVisible="{Binding !CanEdit}" />

        <TextBlock Classes="section" Text="基本信息" />
        <Border Classes="card">
            <StackPanel>
                <Grid Classes="item" ColumnDefinitions="Auto,*">
                    <TextBlock Text="组织名称" />
                    <TextBox Grid.Column="1" Classes="input" Width="260" HorizontalAlignment="Right" MaxLength="40"
                             Text="{Binding Name}" IsEnabled="{Binding CanEdit}" />
                </Grid>
                <c:SettingSource Zulip="name" />
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="消息" />
        <Border Classes="card">
            <StackPanel>
                <Grid Classes="item" ColumnDefinitions="*,Auto">
                    <TextBlock Text="允许编辑消息" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowEditing}" IsEnabled="{Binding CanEdit}" />
                </Grid>
                <c:SettingSource Zulip="allow_message_editing" />
                <Border Classes="divider" />
                <Grid Classes="item" ColumnDefinitions="*,Auto">
                    <TextBlock Text="编辑时限" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding Limit}"
                              IsEnabled="{Binding CanEditLimit}" />
                </Grid>
                <c:SettingSource Zulip="message_content_edit_limit_seconds" />
                <Border Classes="divider" />
                <Grid Classes="item" ColumnDefinitions="*,Auto">
                    <TextBlock Text="已读回执" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReadReceipts}" IsEnabled="{Binding CanEdit}" />
                </Grid>
                <c:SettingSource Zulip="enable_read_receipts" />
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="权限" />
        <Border Classes="card">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:PermissionRowViewModel">
                        <StackPanel>
                            <Grid Classes="item" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}" />
                                <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Choices}"
                                          SelectedItem="{Binding Selected}" IsEnabled="{Binding IsEditable}" />
                            </Grid>
                            <c:SettingSource Zulip="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
