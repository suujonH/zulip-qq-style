<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels.Settings"
             xmlns:c="using:ZulipQQ.Controls"
             x:Class="ZulipQQ.Views.Settings.GroupMessagesPageView"
             x:DataType="vm:GroupMessagesPageViewModel">
    <UserControl.Styles>
        <Style Selector="ToggleButton.expander">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ToggleButton.expander c|TdIcon.arrow">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton.expander:checked c|TdIcon.arrow">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="ItemsControl.channels">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:LevelRowViewModel">
            <Grid Classes="item" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:ChannelLevelGroupViewModel">
            <Border Classes="card">
                <StackPanel>
                    <Grid Classes="item" ColumnDefinitions="*">
                        <ToggleButton Classes="expander" IsChecked="{Binding IsExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:TdIcon Classes="arrow" Icon="{StaticResource Icon.ChevronRight}" Width="14" Height="14"
                                          Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <c:Avatar Width="24" Height="24" Text="{Binding Name}" Fill="{Binding Fill}" />
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    <StackPanel IsVisible="{Binding IsExpanded}" Margin="22,0,0,4">
                        <TextBlock Classes="hint" Text="正在加载…" Margin="0,4" IsVisible="{Binding IsLoading}" />
                        <TextBlock Classes="hint" Text="暂无话题" Margin="0,4" IsVisible="{Binding HasNoTopics}" />
                        <ItemsControl ItemsSource="{Binding Topics}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel Spacing="8">
        <TextBlock Classes="pageTitle" Text="话题消息设置" />
        <c:SettingSource Local="Account" />

        <TextBlock Classes="section" Text="频道" />
        <ItemsControl Classes="channels" ItemsSource="{Binding Channels}" />
        <!-- 已归档的频道：默认收起，仍可设置 -->
        <ToggleButton Classes="expander" IsChecked="{Binding ArchivedExpanded}" IsVisible="{Binding HasArchivedChannels}"
                      MinHeight="32">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:TdIcon Classes="arrow" Icon="{StaticResource Icon.ChevronRight}" Width="14" Height="14"
                          Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ArchivedTitle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <ItemsControl Classes="channels" ItemsSource="{Binding ArchivedChannels}" IsVisible="{Binding ArchivedExpanded}" />

        <TextBlock Classes="section" Text="多人私聊" IsVisible="{Binding HasGroupDms}" />
        <Border Classes="card" IsVisible="{Binding HasGroupDms}">
            <ItemsControl ItemsSource="{Binding GroupDms}" />
        </Border>
    </StackPanel>
</UserControl>
