<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ZulipQQ.Controls"
             xmlns:vm="using:ZulipQQ.ViewModels.Settings"
             x:Class="ZulipQQ.Views.Settings.FilesPageView"
             x:DataType="vm:FilesPageViewModel">
    <StackPanel Spacing="8">
        <TextBlock Classes="pageTitle" Text="数据目录" />

        <TextBlock Classes="section" Text="将接收或下载的文件保存到" />
        <Border Classes="card" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Classes="hint" Text="{Binding SaveRoot}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="ChangeSaveButton" Grid.Column="1" Classes="secondary" Theme="{StaticResource FlatButton}"
                        Content="更改" Margin="12,0,8,0" />
                <Button Grid.Column="2" Classes="secondary" Theme="{StaticResource FlatButton}"
                        Content="打开" Command="{Binding OpenSaveFolderCommand}" />
                <c:SettingSource Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Local="App" />
            </Grid>
        </Border>

        <TextBlock Classes="section" Text="聊天信息默认保存到" />
        <Border Classes="card" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="hint" Text="{Binding DataRoot}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="ChangeDataButton" Grid.Column="1" Classes="secondary" Theme="{StaticResource FlatButton}"
                        Content="更改" Margin="12,0,8,0" IsEnabled="{Binding !IsMoving}" />
                <Button Grid.Column="2" Classes="secondary" Theme="{StaticResource FlatButton}"
                        Content="打开" Command="{Binding OpenDataFolderCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
