<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels.Settings"
             xmlns:c="using:ZulipQQ.Controls"
             x:Class="ZulipQQ.Views.Settings.PalettePageView"
             x:DataType="vm:PalettePageViewModel">
    <UserControl.Styles>
        <!-- 预设色卡：选中时外圈为强调色描边 -->
        <Style Selector="Button.preset">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.preset Border.swatch">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.preset.selected Border.swatch">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="pageTitle" Text="超级调色盘" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Classes="hint" Text="预览夜间" />
                <ToggleSwitch IsChecked="{Binding PreviewDark}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="secondary" Theme="{StaticResource FlatButton}" Content="恢复默认"
                    Command="{Binding ResetCommand}" />
        </Grid>

        <TextBlock Classes="section" Text="随心调" />
        <Border Classes="card">
            <Grid Classes="item" ColumnDefinitions="*,Auto">
                <TextBlock Text="强调色" />
                <ColorPicker Grid.Column="1" Color="{Binding AccentColor}" IsAlphaEnabled="False"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Classes="section" Text="背景图片" />
        <Border Classes="card">
            <StackPanel>
                <Grid Classes="item" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="主窗口背景" />
                    <Button x:Name="PickImageButton" Grid.Column="1" Classes="secondary" Theme="{StaticResource FlatButton}"
                            Content="上传图片" />
                    <Button Grid.Column="2" Classes="secondary" Theme="{StaticResource FlatButton}" Content="移除"
                            Margin="8,0,0,0" IsVisible="{Binding HasBackground}" Command="{Binding ClearBackgroundCommand}" />
                </Grid>
                <Border Classes="divider" IsVisible="{Binding HasBackground}" />
                <Grid Classes="item" ColumnDefinitions="*,220" IsVisible="{Binding HasBackground}">
                    <TextBlock Text="面板不透明度" />
                    <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{Binding MinPanelOpacity}" Maximum="1"
                            SmallChange="0.05" LargeChange="0.1" Value="{Binding PanelOpacity}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="定制" />
        <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetItemViewModel">
                    <Button Classes="preset" Classes.selected="{Binding IsSelected}"
                            Command="{Binding $parent[UserControl].((vm:PalettePageViewModel)DataContext).SelectPresetCommand}"
                            CommandParameter="{Binding}">
                        <StackPanel Spacing="4">
                            <Border Classes="swatch" Padding="2">
                                <Border CornerRadius="4" Background="{Binding Fill}" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSub}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
