<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels"
        xmlns:c="using:ZulipQQ.Controls"
        xmlns:v="using:ZulipQQ.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1090" d:DesignHeight="694"
        x:Class="ZulipQQ.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ZulipQQ"
        Width="1090" Height="694" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Styles>
        <!-- 标题栏整行可拖动；编辑个性签名时整行接收输入，点击签名旁边时结束编辑（拖动区域的点击不会到达程序） -->
        <Style Selector="Grid.titleBar">
            <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="TitleBar" />
        </Style>
        <Style Selector="Grid.titleBar.editing">
            <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
        </Style>
        <!-- 标题栏个性签名：悬停时显示底色提示可编辑 -->
        <Style Selector="Button.signature">
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- 标题栏右侧窗口按钮 -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption c|TdIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 左侧导航按钮 -->
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav c|TdIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        </Style>
        <!-- 可切换按钮的线框图标（仿 QQ）：按住时变淡；选中后藏在实心图标下保持淡色，被切走时从淡色渐变回来。
             “按住”和“选中”分别作用在外层 Panel.press 和图标自身上：松开时两个状态会先后变化，
             放在同一属性上会让过渡从中间值 1 重新开始，出现闪一下深色的问题 -->
        <Style Selector="Button.nav Panel.press, Button.nav c|TdIcon.outline">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav c|TdIcon.outline">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav:pressed Panel.press, Button.nav.active c|TdIcon.outline">
            <Setter Property="Opacity" Value="0.3" />
        </Style>

        <!-- 主菜单：顶部图标按钮与菜单行 -->
        <Style Selector="Button.menuTile">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.menuTile StackPanel">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="Button.menuTile c|TdIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.menuTile TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSub}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.menuRow">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.menuRow c|TdIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.menuRow TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 导航按钮右上角的未读总数 -->
        <Style Selector="Border.navBadge">
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-3,-9,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.navBadge.dot">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,-1,-3,0" />
        </Style>
        <Style Selector="Border.navBadge > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 多个账号时导航中的账号头像：展开的账号有底色 -->
        <Style Selector="Button.account">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.account.active">
            <Setter Property="Background" Value="{DynamicResource FillBrush}" />
        </Style>
        <!-- 账号头像的未读角标：按钮会裁掉超出的部分，往里收，不超出按钮 -->
        <Style Selector="Button.account Border.navBadge">
            <Setter Property="Margin" Value="0,-3,-5,0" />
        </Style>
        <!-- 正在登录、登录失败的账号头像变淡 -->
        <Style Selector="Button.account c|Avatar.offline">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.accountFailed">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#E37318" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-3,-3" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.accountFailed > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 提示条：顶部居中的黑色半透明文字 -->
        <Style Selector="Border.toast">
            <Setter Property="Background" Value="#CC000000" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,56,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">
        <!-- 超级调色盘的背景图：铺满整个窗口，主面板半透明时透出 -->
        <Image Grid.Row="0" Grid.RowSpan="2" Source="{DynamicResource ThemeBackgroundImage}" Stretch="UniformToFill"
               IsHitTestVisible="False" />

        <!-- 标题栏：整行可拖动，内部可点击的元素标记为 User 以接收输入 -->
        <Grid Grid.Row="0" Classes="titleBar" Classes.editing="{Binding IsEditingSignature}"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              Background="Transparent">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                <c:TdIcon Icon="{StaticResource Icon.QqFilled}" Width="14" Height="14" />
                <TextBlock Text="QQ" FontSize="{DynamicResource FontSizeSub}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="TitleUser" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        Margin="22,0,0,0" VerticalAlignment="Center">
                <Panel Width="24" Height="24">
                    <c:Avatar Width="24" Height="24" Source="{Binding SelfAvatarUrl}" Text="{Binding SelfName}" />
                    <Ellipse Classes="online" Width="9" Height="9" Margin="0,0,-2,-2" />
                </Panel>
                <TextBlock Text="{Binding SelfName}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
                <!-- 个性签名：点击就地编辑（经典模式窗口太窄，不显示） -->
                <Panel VerticalAlignment="Center" IsVisible="{Binding !IsClassicMode}">
                    <Button Classes="signature" Theme="{StaticResource FlatButton}" ToolTip.Tip="编辑个性签名"
                            IsVisible="{Binding !IsEditingSignature}" Command="{Binding BeginEditSignatureCommand}"
                            chrome:WindowDecorationProperties.ElementRole="User">
                        <TextBlock Classes="sub" Text="{Binding SignatureText}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <c:InlineEditBox Classes="input" Width="220" MaxLength="{x:Static vm:MainViewModel.SignatureMaxLength}"
                                     Text="{Binding SignatureDraft}" IsVisible="{Binding IsEditingSignature}"
                                     CommitCommand="{Binding CommitSignatureCommand}"
                                     CancelCommand="{Binding CancelEditSignatureCommand}"
                                     chrome:WindowDecorationProperties.ElementRole="User" />
                </Panel>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="LayoutButton" Classes="caption" Theme="{StaticResource FlatButton}" Command="{Binding ToggleClassicModeCommand}"
                        ToolTip.Tip="{Binding LayoutTip}" chrome:WindowDecorationProperties.ElementRole="User">
                    <c:TdIcon Icon="{StaticResource Icon.Layout}" />
                </Button>
                <Button Classes="caption" Theme="{StaticResource FlatButton}" Click="OnMinimizeClick"
                        chrome:WindowDecorationProperties.ElementRole="User">
                    <c:TdIcon Icon="{StaticResource Icon.Minus}" />
                </Button>
                <Button Classes="caption" Theme="{StaticResource FlatButton}" Click="OnMaximizeClick"
                        chrome:WindowDecorationProperties.ElementRole="User">
                    <c:TdIcon Icon="{StaticResource Icon.Rectangle}" Width="13" Height="13" />
                </Button>
                <Button Classes="caption close" Theme="{StaticResource FlatButton}" Click="OnCloseClick"
                        chrome:WindowDecorationProperties.ElementRole="User">
                    <c:TdIcon Icon="{StaticResource Icon.Close}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体：导航栏 | 当前页面 | 右侧内容区 -->
        <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="8,0,0,0" ClipToBounds="True"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,0,0">
            <!-- 经典模式时由窗口改为 52,*,0 并隐藏右侧内容区 -->
            <Grid x:Name="BodyGrid" ColumnDefinitions="52,318,*">
                <Border Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,8">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button x:Name="MainMenuButton" Classes="nav" Theme="{StaticResource FlatButton}"
                                    ToolTip.Tip="主菜单">
                                <c:TdIcon Icon="{StaticResource Icon.ViewList}" />
                                <Button.Flyout>
                                    <!-- 主菜单（仿 QQ）：顶部一行图标按钮，下面是菜单项 -->
                                    <Flyout Placement="RightEdgeAlignedBottom">
                                        <StackPanel Width="164">
                                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                                <Button x:Name="FavoritesTile" Classes="menuTile" Click="OnFavoritesClick">
                                                    <StackPanel>
                                                        <c:TdIcon Icon="{StaticResource Icon.Star}" />
                                                        <TextBlock Text="收藏" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="FilesTile" Classes="menuTile" Click="OnFilesClick">
                                                    <StackPanel>
                                                        <c:TdIcon Icon="{StaticResource Icon.Folder}" />
                                                        <TextBlock Text="文件" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="menuTile" Click="OnPaletteClick">
                                                    <StackPanel>
                                                        <c:TdIcon Icon="{StaticResource Icon.Palette}" />
                                                        <TextBlock Text="调色盘" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                            <Border Height="1" Margin="4,0,4,4" Background="{DynamicResource DividerBrush}" />
                                            <Button Classes="menuRow" Click="OnSettingsClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:TdIcon Icon="{StaticResource Icon.Setting}" />
                                                    <TextBlock Text="设置" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="menuRow" Click="OnAddAccountClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:TdIcon Icon="{StaticResource Icon.Add}" />
                                                    <TextBlock Text="添加账号" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="LogoutRow" Classes="menuRow" Click="OnLogoutClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:TdIcon Icon="{StaticResource Icon.Logout}" />
                                                    <TextBlock Text="退出账号" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- 按账号分组：多个账号时每个账号一个头像，点击展开它的“消息 / 联系人”，其他账号收起并在头像上显示未读 -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding Entries, Source={x:Static vm:AccountHubViewModel.Instance}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountEntryViewModel">
                                        <!-- 未启用的账号不显示（在设置的“Zulip 账号”中启用） -->
                                        <StackPanel IsVisible="{Binding !IsDisabled}">
                                            <Button Classes="account" Classes.active="{Binding IsActive}" Theme="{StaticResource FlatButton}"
                                                    ToolTip.Tip="{Binding ToolTip}" Command="{Binding SelectCommand}"
                                                    IsVisible="{Binding ShowsAccountButtons, Source={x:Static vm:AccountHubViewModel.Instance}}">
                                                <Panel Width="30" Height="30">
                                                    <!-- 头像属于该账号的组织：用该账号的客户端下载 -->
                                                    <c:Avatar Width="30" Height="30" Source="{Binding AvatarUrl}" Text="{Binding DisplayName}"
                                                              c:RealmImage.Client="{Binding Session.Client, FallbackValue={x:Null}}"
                                                              Classes.offline="{Binding !IsOnline}" />
                                                    <Border Classes="navBadge" IsVisible="{Binding ShowsBadge}">
                                                        <TextBlock Text="{Binding UnreadText}" />
                                                    </Border>
                                                    <Border Classes="navBadge dot" IsVisible="{Binding ShowsDot}" />
                                                    <!-- 登录失败：右下角警告标记 -->
                                                    <Border Classes="accountFailed" IsVisible="{Binding IsFailed}">
                                                        <TextBlock Text="!" />
                                                    </Border>
                                                </Panel>
                                            </Button>
                                            <!-- 切换账号时，“消息 / 联系人”按动画展开、收起 -->
                                            <c:ExpandPanel IsExpanded="{Binding IsActive}">
                                            <StackPanel>
                                                <Button Classes="nav" Classes.active="{Binding Main.IsMessagesActive, FallbackValue=False}" ToolTip.Tip="消息"
                                                        Theme="{StaticResource FlatButton}" Command="{Binding Main.ShowMessagesCommand, FallbackValue={x:Null}}">
                                                    <!-- 线框图标常驻，选中时实心图标从左下角圆形扩散盖住它 -->
                                                    <Panel>
                                                        <Panel Classes="press">
                                                            <c:TdIcon Classes="outline" Icon="{StaticResource Icon.Chat}" />
                                                        </Panel>
                                                        <c:CircleReveal IsRevealed="{Binding Main.IsMessagesActive, FallbackValue=False}">
                                                            <c:TdIcon Icon="{StaticResource Icon.ChatFilled}" />
                                                        </c:CircleReveal>
                                                        <Border Classes="navBadge" IsVisible="{Binding Main.Messages.HasTotalUnread, FallbackValue=False}">
                                                            <TextBlock Text="{Binding Main.Messages.TotalUnreadText, FallbackValue={x:Null}}" />
                                                        </Border>
                                                    </Panel>
                                                </Button>
                                                <Button Classes="nav" Classes.active="{Binding Main.IsContactsActive, FallbackValue=False}" ToolTip.Tip="联系人"
                                                        Theme="{StaticResource FlatButton}" Command="{Binding Main.ShowContactsCommand, FallbackValue={x:Null}}">
                                                    <Panel>
                                                        <Panel Classes="press">
                                                            <c:TdIcon Classes="outline" Icon="{StaticResource Icon.User}" />
                                                        </Panel>
                                                        <c:CircleReveal IsRevealed="{Binding Main.IsContactsActive, FallbackValue=False}">
                                                            <c:TdIcon Icon="{StaticResource Icon.UserFilled}" />
                                                        </c:CircleReveal>
                                                        <!-- 系统通知、消息提醒未读 -->
                                                        <Border Classes="navBadge dot" IsVisible="{Binding Main.HasContactsDot, FallbackValue=False}" />
                                                    </Panel>
                                                </Button>
                                            </StackPanel>
                                            </c:ExpandPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <Panel>
                    <!-- 没有在线的账号：引导登录或添加账号 -->
                    <StackPanel x:Name="EmptyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24,0" IsVisible="False">
                        <TextBlock Text="还没有登录的账号" HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" />
                        <TextBlock Classes="sub" Text="在设置的“Zulip 账号”中启用账号，或添加一个账号" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Classes="primary" Theme="{StaticResource FlatButton}" Content="添加账号" HorizontalAlignment="Center"
                                Margin="0,6,0,0" Click="OnAddAccountClick" />
                    </StackPanel>
                    <DockPanel x:Name="AccountContent">
                        <!-- 搜索栏两个页面共用 -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,12,12,8">
                            <TextBox x:Name="SearchBox" Classes="search" PlaceholderText="搜索"
                                     Text="{Binding Search.Query}" KeyDown="OnSearchKeyDown">
                                <TextBox.InnerLeftContent>
                                    <c:TdIcon Icon="{StaticResource Icon.Search}" Width="14" Height="14"
                                              Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <Button Grid.Column="1" Width="28" Height="28" Margin="8,0,0,0"
                                    Theme="{StaticResource FlatButton}" Background="{DynamicResource FillBrush}"
                                    Foreground="{DynamicResource TextSecondaryBrush}" Click="OnAddClick">
                                <c:TdIcon Icon="{StaticResource Icon.Add}" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <Panel>
                            <ContentControl Content="{Binding CurrentPage}" />
                            <!-- 搜索框有内容时，结果浮层盖在当前页面上 -->
                            <v:SearchResultsView x:Name="SearchResults" DataContext="{Binding Search}" IsVisible="{Binding IsOpen}" />
                        </Panel>
                    </DockPanel>
                    </Panel>
                </Border>

                <!-- 右侧内容区：聊天、资料面板等；没有内容时显示企鹅占位 -->
                <Panel Grid.Column="2" IsVisible="{Binding !IsClassicMode}">
                    <!-- 预热聊天视图：几乎透明（透明度为 0 时不会渲染），不响应鼠标，渲染一次后移除 -->
                    <Panel x:Name="WarmupHost" Opacity="0.01" IsHitTestVisible="False" />
                    <c:TdIcon Icon="{StaticResource Icon.QqFilled}" Width="90" Height="90"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{DynamicResource PlaceholderLogoBrush}" IsVisible="{Binding !HasRightPane}" />
                    <ContentControl Content="{Binding RightPane}" IsVisible="{Binding HasRightPane}" />
                </Panel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Classes="toast" IsVisible="{Binding HasToast}">
            <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" />
        </Border>

        <c:DialogLayer Grid.Row="0" Grid.RowSpan="2" Dialogs="{Binding Dialogs}" />
    </Grid>
</Window>
