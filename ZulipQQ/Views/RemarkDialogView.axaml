<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels"
             xmlns:c="using:ZulipQQ.Controls"
             x:Class="ZulipQQ.Views.RemarkDialogView"
             x:DataType="vm:RemarkDialogViewModel">

    <Border Classes="dialog" Width="320">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSmall}" HorizontalAlignment="Center" Margin="0,7" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" />

            <StackPanel Margin="20" Spacing="8">
                <TextBox x:Name="RemarkBox" Classes="input" PlaceholderText="填写备注，留空则清除备注" Text="{Binding Remark}">
                    <TextBox.InnerRightContent>
                        <Button Theme="{StaticResource FlatButton}" Background="Transparent" Width="24" Height="24"
                                Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                Command="{Binding ClearCommand}"
                                IsVisible="{Binding Remark, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <c:TdIcon Icon="{StaticResource Icon.Close}" Width="14" Height="14" />
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock Text="{Binding OriginalText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                    <Button Classes="primary" Theme="{StaticResource FlatButton}" Content="确定"
                            Command="{Binding ConfirmCommand}" />
                    <Button Classes="secondary" Theme="{StaticResource FlatButton}" Content="取消"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
