<!-- 右侧资料面板：名片在内容区居中显示 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels"
             x:Class="ZulipQQ.Views.ProfilePaneView"
             x:DataType="vm:ProfilePaneViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ContentControl Content="{Binding Card}" MaxWidth="360" Margin="0,40"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
    </ScrollViewer>
</UserControl>
