<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels"
        xmlns:c="using:ZulipQQ.Controls"
        x:Class="ZulipQQ.Views.FavoritesWindow"
        x:DataType="vm:FavoritesViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="收藏"
        Width="960" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Styles>
        <!-- 左栏分类：选中项为填充底色 -->
        <Style Selector="Button.category">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Button.category.active">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
        </Style>
        <Style Selector="Button.category c|TdIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.category TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Grid.favoriteRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid.favoriteRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200,*">
        <!-- 左栏：搜索与分类 -->
        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,40,8,8">
                <TextBox x:Name="SearchBox" Classes="search" PlaceholderText="搜索" Text="{Binding Query}"
                         Margin="0,0,0,8">
                    <TextBox.InnerLeftContent>
                        <c:TdIcon Icon="{StaticResource Icon.Search}" Width="14" Height="14"
                                  Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Classes="category" Classes.active="{Binding IsAll}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="{x:Static vm:FavoriteCategory.All}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:TdIcon Icon="{StaticResource Icon.App}" />
                        <TextBlock Text="全部" />
                    </StackPanel>
                </Button>
                <Button Classes="category" Classes.active="{Binding IsChat}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="{x:Static vm:FavoriteCategory.Chat}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:TdIcon Icon="{StaticResource Icon.Time}" />
                        <TextBlock Text="聊天记录" />
                    </StackPanel>
                </Button>
                <Button Classes="category" Classes.active="{Binding IsMedia}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="{x:Static vm:FavoriteCategory.Media}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:TdIcon Icon="{StaticResource Icon.Image}" />
                        <TextBlock Text="图片与视频" />
                    </StackPanel>
                </Button>
                <Button Classes="category" Classes.active="{Binding IsFiles}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="{x:Static vm:FavoriteCategory.Files}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:TdIcon Icon="{StaticResource Icon.Folder}" />
                        <TextBlock Text="文件" />
                    </StackPanel>
                </Button>
                <Button Classes="category" Classes.active="{Binding IsLinks}" Command="{Binding SelectCategoryCommand}"
                        CommandParameter="{x:Static vm:FavoriteCategory.Links}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:TdIcon Icon="{StaticResource Icon.Link}" />
                        <TextBlock Text="链接" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 右栏：分类标题与收藏列表 -->
        <Grid Grid.Column="1" RowDefinitions="30,Auto,*">
            <TextBlock Grid.Row="1" Text="{Binding CategoryTitle}" FontSize="{DynamicResource FontSizeH3}" Margin="20,0,0,10" />

            <Panel Grid.Row="2">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FavoriteItem">
                                    <Grid Classes="favoriteRow" DoubleTapped="OnItemDoubleTapped">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="取消收藏" Command="{Binding UnstarCommand}" />
                                                <MenuItem Header="复制" Command="{Binding CopyCommand}" />
                                                <MenuItem Header="转发" Command="{Binding ForwardCommand}" />
                                                <MenuItem Header="定位到聊天" Command="{Binding LocateCommand}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="108" Margin="28,0">
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                                        Margin="0,16">
                                                <c:RemoteImage Width="72" Height="72" CornerRadius="4"
                                                               Source="{Binding Thumbnail.Src}" Href="{Binding Thumbnail.Href}"
                                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            IsVisible="{Binding File, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <c:TdIcon IconKey="{Binding FileIconKey}" Width="36" Height="36"
                                                              Foreground="{DynamicResource BrandBrush}" />
                                                    <TextBlock Text="{Binding File.FileName}" FontSize="{DynamicResource FontSizeBody}" MaxWidth="420"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="{DynamicResource FontSizeBody}" MaxWidth="520" MaxLines="3"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                        Margin="16,0,0,0">
                                                <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource FontSizeSub}" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding FromText}" FontSize="{DynamicResource FontSizeSub}" HorizontalAlignment="Right"
                                                           MaxWidth="160" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Margin="28,0" VerticalAlignment="Bottom"
                                                Background="{DynamicResource DividerBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="加载中…" FontSize="{DynamicResource FontSizeSub}" HorizontalAlignment="Center" Margin="0,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsLoadingMore}" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Border Background="#CC000000" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,16,0,0"
                        IsVisible="{Binding ToastText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" />
                </Border>
            </Panel>
        </Grid>

        <c:CaptionBar Grid.ColumnSpan="2" Height="30" VerticalAlignment="Top" />
    </Grid>
</Window>
