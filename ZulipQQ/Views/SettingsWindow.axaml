<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels.Settings"
        xmlns:c="using:ZulipQQ.Controls"
        x:Class="ZulipQQ.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="设置"
        Width="760" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- 各设置页共用的样式：灰底上的白色圆角卡片，每行左边文字、右边控件 -->
    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Theme" Value="{StaticResource FlatButton}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
        </Style>
        <Style Selector="Button.nav TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeH2}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSub}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,8,0,0" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,4" />
        </Style>
        <Style Selector="Grid.item">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Grid.item > TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">
        <c:CaptionBar Grid.Row="0" Height="30" VerticalAlignment="Top" ShowMaximize="False" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <c:TdIcon Icon="{StaticResource Icon.Setting}" Width="16" Height="16" />
            <TextBlock Text="设置" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="8,8,0,0" ClipToBounds="True"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,1,0">
            <Grid ColumnDefinitions="160,*">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Nav}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsNavItem">
                                    <Button Classes="nav" Classes.active="{Binding IsSelected}"
                                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Title}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Panel Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding CurrentPage}" Margin="20,16,20,20" />
                    </ScrollViewer>
                    <Border Background="#CC000000" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,16,0,0"
                            IsVisible="{Binding ToastText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" />
                    </Border>
                </Panel>
            </Grid>
        </Border>

        <c:DialogLayer Grid.Row="0" Grid.RowSpan="2" Dialogs="{Binding Dialogs}" />
    </Grid>
</Window>
