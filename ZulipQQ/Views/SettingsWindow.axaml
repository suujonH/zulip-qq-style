<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels.Settings"
        xmlns:c="using:ZulipQQ.Controls"
        x:Class="ZulipQQ.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="设置"
        Width="1060" Height="600" MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- 各设置页共用的样式 -->
    <Window.Styles>
        <StyleInclude Source="avares://ZulipQQ/Styles/SettingsPages.axaml" />
    </Window.Styles>

    <Grid RowDefinitions="38,*" Classes.showSource="{Binding ShowSettingSource}">
        <c:CaptionBar Grid.Row="0" Height="30" VerticalAlignment="Top" ShowMaximize="False" />
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <c:TdIcon Icon="{StaticResource Icon.Setting}" Width="16" Height="16" />
            <TextBlock Text="设置" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="8,8,0,0" ClipToBounds="True"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,1,0">
            <Grid ColumnDefinitions="160,*">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <!-- 二级列表的点击由窗口处理（滚动到分组） -->
                        <ItemsControl x:Name="NavList" ItemsSource="{Binding Nav}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsNavItem">
                                    <StackPanel>
                                        <Button Classes="nav" Classes.active="{Binding IsSelected}"
                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).SelectCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Title}" />
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding HasSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsNavSection">
                                                    <Button Classes="nav sub" Classes.active="{Binding IsSelected}">
                                                        <TextBlock Text="{Binding Title}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Panel Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding ScrolledPage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding ScrolledPage}" Margin="20,16,20,20" />
                    </ScrollViewer>
                    <!-- “Zulip 账号”：账号列表、账号的设置导航与页面，自己布局、滚动，并显示自己的保存提示 -->
                    <ContentControl Content="{Binding FilledPage}"
                                    IsVisible="{Binding FilledPage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Classes="saveTip" IsVisible="{Binding ScrolledPage.HasUnsavedChanges, FallbackValue=False}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="tipText" Text="有未保存的修改" />
                            <Button Classes="secondary" Theme="{StaticResource FlatButton}" Content="撤销"
                                    Command="{Binding ScrolledPage.DiscardChangesCommand, FallbackValue={x:Null}}" />
                            <Button Classes="primary" Theme="{StaticResource FlatButton}" Content="保存"
                                    Command="{Binding ScrolledPage.SaveChangesCommand, FallbackValue={x:Null}}" />
                        </StackPanel>
                    </Border>
                    <Border Background="#CC000000" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,16,0,0"
                            IsVisible="{Binding ToastText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" />
                    </Border>
                </Panel>
            </Grid>
        </Border>

        <c:DialogLayer Grid.Row="0" Grid.RowSpan="2" Dialogs="{Binding Dialogs}" />
    </Grid>
</Window>
