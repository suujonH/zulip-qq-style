<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZulipQQ.ViewModels"
        xmlns:c="using:ZulipQQ.Controls"
        x:Class="ZulipQQ.Views.PluginLogWindow"
        x:DataType="vm:PluginLogViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="720" Height="480" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Styles>
        <Style Selector="SelectableTextBlock.log">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.log.debug">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.log.success">
            <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.log.io">
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.log.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.log.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="30,*">
        <c:CaptionBar Grid.Row="0" Title="{Binding Title}" />

        <Border Grid.Row="1" Margin="2,0,2,2" CornerRadius="8,8,0,0" ClipToBounds="True"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,1,0">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer x:Name="LogScroller" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PluginLogRowViewModel">
                                <SelectableTextBlock Classes="log" Margin="0,1"
                                                     Classes.debug="{Binding IsDebug}" Classes.success="{Binding IsSuccess}"
                                                     Classes.io="{Binding IsIo}" Classes.warning="{Binding IsWarning}"
                                                     Classes.error="{Binding IsError}">
                                    <Run Text="{Binding TimeText}" /><Run Text=" [" /><Run Text="{Binding LevelText}" /><Run Text="] " /><Run Text="{Binding Category}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text}" />
                                </SelectableTextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="CopyButton" Classes="secondary" Theme="{StaticResource FlatButton}" Content="复制" />
                        <Button Classes="secondary" Theme="{StaticResource FlatButton}" Content="清空"
                                Command="{Binding ClearCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
