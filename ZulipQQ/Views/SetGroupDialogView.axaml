<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels"
             xmlns:c="using:ZulipQQ.Controls"
             x:Class="ZulipQQ.Views.SetGroupDialogView"
             x:DataType="vm:SetGroupDialogViewModel">

    <UserControl.Styles>
        <Style Selector="ComboBox.group">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="MaxDropDownHeight" Value="240" />
        </Style>
        <Style Selector="TextBlock.createNew">
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="dialog" Width="320" Background="{DynamicResource PanelBackgroundBrush}">
        <StackPanel>
            <Grid Height="30">
                <TextBlock Text="设置分组" FontSize="{DynamicResource FontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Theme="{StaticResource FlatButton}" Width="30" Height="30" CornerRadius="0,8,0,0"
                        HorizontalAlignment="Right" Command="{Binding CancelCommand}">
                    <c:TdIcon Icon="{StaticResource Icon.Close}" Width="14" Height="14" />
                </Button>
            </Grid>

            <StackPanel Margin="20,10,20,20" Spacing="8">
                <TextBlock Classes="sub" Text="分组" FontSize="{DynamicResource FontSizeSmall}" />
                <ComboBox Classes="group" PlaceholderText="请选择"
                          ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupChoice">
                            <TextBlock Text="{Binding Name}" Classes.createNew="{Binding IsCreateNew}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                    <Button Classes="primary" Theme="{StaticResource FlatButton}" Content="确定"
                            Command="{Binding ConfirmCommand}" />
                    <Button Classes="secondary" Theme="{StaticResource FlatButton}" Content="取消"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
