<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZulipQQ.ViewModels"
             xmlns:c="using:ZulipQQ.Controls"
             x:Class="ZulipQQ.Views.TopicCardView"
             x:DataType="vm:TopicCardViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Width" Value="64" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="DockPanel.row">
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.editable">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Border Width="320" Padding="20" CornerRadius="8" Background="{DynamicResource CardBrush}">
        <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*">
                <c:Avatar Width="64" Height="64" Text="{Binding Title}" Fill="{Binding AvatarFill}" VerticalAlignment="Top" />
                <!-- 频道名在话题名上方，用灰色小字，与话题名区分 -->
                <StackPanel Grid.Column="1" Margin="14,4,0,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <c:TdIcon Icon="{StaticResource Icon.Lock}" Width="12" Height="12" IsVisible="{Binding IsPrivate}"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ChannelText}" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerBrush}" />

            <DockPanel Classes="row">
                <TextBlock Classes="label" Text="话题备注" />
                <Panel>
                    <Button Classes="editable" Theme="{StaticResource FlatButton}"
                            Command="{Binding BeginEditRemarkCommand}" IsVisible="{Binding !IsEditingRemark}">
                        <Panel>
                            <TextBlock Classes="value" Text="{Binding RemarkText}" />
                            <TextBlock Classes="value" Text="设置备注" Foreground="{DynamicResource TextTertiaryBrush}"
                                       IsVisible="{Binding RemarkText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </Panel>
                    </Button>
                    <c:InlineEditBox Classes="input" MaxLength="32" Text="{Binding RemarkDraft}"
                                     IsVisible="{Binding IsEditingRemark}"
                                     CommitCommand="{Binding CommitRemarkCommand}"
                                     CancelCommand="{Binding CancelRemarkCommand}" />
                </Panel>
            </DockPanel>

            <Button Classes="primary" Theme="{StaticResource FlatButton}" HorizontalAlignment="Center" MinWidth="120"
                    Content="发消息" Command="{Binding SendMessageCommand}" />
        </StackPanel>
    </Border>
</UserControl>
