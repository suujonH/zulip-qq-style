<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 开发者模式只在 Debug 中提供：其它配置不编译它的页面、请求详情窗口和请求记录 -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="ViewModels\Settings\DeveloperPageViewModel.cs" />
    <Compile Remove="Views\Settings\DeveloperPageView.axaml.cs" />
    <Compile Remove="Views\RequestDetailWindow.axaml.cs" />
    <Compile Remove="Services\RequestLog.cs" />
    <AvaloniaXaml Remove="Views\Settings\DeveloperPageView.axaml" />
    <AvaloniaXaml Remove="Views\RequestDetailWindow.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
</Project>
